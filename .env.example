DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local development only: a seeded workspace enables Calendar without a login.
DEV_WORKSPACE_ID=
SESSION_COOKIE_NAME=mydrivelog_session
APP_BASE_URL=http://localhost:3000
BREVO_API_KEY=
RESEND_API_KEY=
ACCESS_EMAIL_FROM=MyDriveLog <hello@mydrivelog.co.uk>
# Firebase client configuration from the web app registered in the Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin service-account values (server only). Never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Random 32+ character secret for one-time-code hashing; share across deployments using this database.
AUTH_CODE_SECRET=
GEMINI_API_KEY=
